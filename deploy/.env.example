# 운영 compose(deploy/)용. 실제 값은 서버의 deploy/.env에만 둔다(chmod 600).

# 받을 백엔드 이미지 태그. 비우면 latest, 되돌릴 때 <sha>
BACKEND_TAG=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# 구글 redirect_uri의 바탕. https://jieuni.space
FRONTEND_URL=
# 백엔드가 재생성을 부를 주소. 비우면 FRONTEND_URL
REVALIDATE_URL=
# Vercel의 REVALIDATE_SECRET과 같은 값. 없으면 prod가 시작하지 않는다
REVALIDATE_SECRET=
ADMIN_EMAILS=
# R2 운영 버킷 jieuni
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# https://photos.jieuni.space
PHOTO_PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# R2 백업 버킷 jieuni-backup만 쓰는 토큰(Object Read & Write). 엔드포인트는 S3_ENDPOINT와 같다
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# 선택: 백업이 끝날 때마다 부를 성공 핑 주소(healthchecks.io 등). 비우면 부르지 않는다
BACKUP_PING_URL=
